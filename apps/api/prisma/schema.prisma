generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  BOOKED
  PAID
  LOST
  ARCHIVED
}

enum ReceiptStatus {
  NEW
  APPROVED
  REJECTED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

enum LessonStatus {
  SCHEDULED
  ATTENDED
  MISSED
  CANCELED
}

model Client {
  id             String   @id @default(cuid())
  projectKey     String   @default("mbpg")
  telegramId     BigInt
  username       String?
  firstName      String?
  lastName       String?
  languageCode   String   @default("ru")
  phone          String?
  notes          String?
  lastSeenAt     DateTime @default(now())
  welcomeSentAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]
  receipts       Receipt[]
  reminders      Reminder[]
  enrollments    Enrollment[]
  lessons        Lesson[]

  @@unique([projectKey, telegramId])
  @@index([projectKey])
}

model Lead {
  id            String     @id @default(cuid())
  projectKey    String     @default("mbpg")
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id])
  parentName    String
  phone         String
  childName     String
  childAge      String
  direction     String
  serviceSlug   String?
  branch        String
  preferredTime String?
  comment       String?
  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  receipts      Receipt[]
  reminders     Reminder[]
  services      LeadService[]
  enrollments   Enrollment[]
  lessons       Lesson[]

  @@index([projectKey, createdAt])
}

model LeadService {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceSlug String
  title       String?
  direction   String?
  createdAt   DateTime @default(now())

  @@index([leadId])
}

model Receipt {
  id          String        @id @default(cuid())
  projectKey  String        @default("mbpg")
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  leadId      String?
  lead        Lead?         @relation(fields: [leadId], references: [id])
  fileName    String
  mimeType    String
  size        Int
  data        Bytes
  status      ReceiptStatus @default(NEW)
  adminNote   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([projectKey, createdAt])
}

model Reminder {
  id          String         @id @default(cuid())
  projectKey  String         @default("mbpg")
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
  type        String
  message     String
  dueAt       DateTime
  status      ReminderStatus @default(SCHEDULED)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectKey, status, dueAt])
}

model Enrollment {
  id           String           @id @default(cuid())
  projectKey   String           @default("mbpg")
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id])
  leadId       String?
  lead         Lead?            @relation(fields: [leadId], references: [id])
  title        String
  direction    String?
  branch       String?
  totalLessons Int              @default(0)
  usedLessons  Int              @default(0)
  status       EnrollmentStatus @default(ACTIVE)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lessons      Lesson[]

  @@index([projectKey, clientId])
  @@index([projectKey, status])
}

model Lesson {
  id           String       @id @default(cuid())
  projectKey   String       @default("mbpg")
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?  @relation(fields: [enrollmentId], references: [id])
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id])
  title        String
  branch       String?
  startsAt     DateTime
  status       LessonStatus @default(SCHEDULED)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([projectKey, clientId, startsAt])
  @@index([projectKey, status, startsAt])
}

model Broadcast {
  id          String    @id @default(cuid())
  projectKey  String    @default("mbpg")
  title       String
  message     String
  audience    String    @default("all")
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?

  @@index([projectKey, createdAt])
}

model Coach {
  id            String   @id @default(cuid())
  projectKey    String   @default("mbpg")
  name          String
  direction     String
  branch        String?
  serviceSlugs  String[] @default([])
  bio           String?
  experience    String?
  isActive      Boolean  @default(true)
  photoFileName String?
  photoMimeType String?
  photoSize     Int?
  photoData     Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectKey, direction])
  @@index([projectKey, isActive])
}

model ContentPost {
  id            String   @id @default(cuid())
  projectKey    String   @default("mbpg")
  type          String
  languageCode  String   @default("ru")
  title         String
  body          String
  direction     String?
  serviceSlugs  String[] @default([])
  ctaLabel      String?
  ctaUrl        String?
  startsAt      DateTime?
  endsAt        DateTime?
  isPublished   Boolean  @default(false)
  imageFileName String?
  imageMimeType String?
  imageSize     Int?
  imageData     Bytes?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectKey, type, isPublished])
  @@index([projectKey, languageCode])
  @@index([projectKey, createdAt])
}
